<!DOCTYPE html>
<html lang="en-ZA">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Seller Dashboard</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<script src="https://cdn.tailwindcss.com"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
<style>
  body { -webkit-tap-highlight-color: transparent; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  input, textarea, button, select { font-size: 16px !important; }
  @media (min-width: 768px) { input, textarea, button, select { font-size: 14px !important; } }
  [x-cloak] { display: none !important; }
</style>
</head>
<body class="bg-gray-50" x-data="sellerApp()" x-init="init()" x-cloak>

<div x-show="loading" class="fixed inset-0 flex items-center justify-center bg-white z-50"><div class="w-10 h-10 border-4 border-gray-200 border-t-gray-900 rounded-full animate-spin"></div></div>

<div x-show="!loading && !session" class="min-h-screen flex items-center justify-center p-5">
  <div class="w-full max-w-md bg-white rounded-3xl shadow-xl p-8">
    <div x-show="loginStep === 'email'">
      <div class="w-12 h-12 rounded-full bg-gray-900 text-white grid place-items-center mx-auto mb-6"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="m22 6-10 7L2 6"/></svg></div>
      <h1 class="text-2xl font-semibold text-center mb-2">Sign in to your store</h1>
      <p class="text-sm text-gray-500 text-center mb-6">I'll email you a login code.</p>
      <form @submit.prevent="sendCode()">
        <input type="email" x-model="loginEmail" placeholder="your@email.com" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none mb-3">
        <button type="submit" class="w-full py-4 rounded-2xl bg-gray-900 text-white font-semibold">Send login code</button>
      </form>
      <button @click="skipLogin()" class="w-full mt-3 text-center text-xs text-gray-500 hover:text-gray-900">Skip for now (demo mode)</button>
    </div>
    <div x-show="loginStep === 'code'" x-cloak>
      <button @click="loginStep = 'email'" class="text-sm text-gray-500 mb-6">← Back</button>
      <h1 class="text-2xl font-semibold mb-2">Enter your code</h1>
      <p class="text-sm text-gray-500 mb-6">Sent to <span x-text="loginEmail" class="font-medium text-gray-900"></span></p>
      <form @submit.prevent="verifyCode()">
        <input type="text" x-model="loginCode" maxlength="6" placeholder="000000" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none mb-3 text-center tracking-widest text-2xl font-mono">
        <button type="submit" class="w-full py-4 rounded-2xl bg-gray-900 text-white font-semibold">Sign in</button>
      </form>
      <p class="text-xs text-gray-400 text-center mt-3">Demo: any 4-6 digits work</p>
    </div>
  </div>
</div>

<div x-show="!loading && session" class="min-h-screen">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-30">
    <div class="max-w-md md:max-w-6xl mx-auto px-4 md:px-6">
      <div class="py-3 flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h1 class="text-lg md:text-2xl font-semibold text-gray-900 truncate" x-text="store.brand?.name"></h1>
          <p class="text-xs text-gray-500 mt-0.5">Seller Dashboard</p>
        </div>
        <div class="flex items-center gap-2">
          <button @click="openSettings()" class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white border border-gray-200 text-sm font-medium hover:bg-gray-50">Settings</button>
          <button @click="logout()" class="px-3 py-2 rounded-xl text-xs text-gray-500 hover:bg-gray-100">Sign out</button>
        </div>
      </div>
      <nav class="flex gap-1 pb-2 border-b border-gray-100 -mb-px">
        <button @click="activeTab = 'products'" :class="activeTab === 'products' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'" class="px-4 py-2 border-b-2 text-sm font-medium">Products</button>
        <button @click="activeTab = 'orders'" :class="activeTab === 'orders' ? 'border-gray-900 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-900'" class="px-4 py-2 border-b-2 text-sm font-medium flex items-center gap-2">Orders <span x-show="newOrdersCount() > 0" x-text="newOrdersCount()" class="px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold"></span></button>
      </nav>
    </div>
  </header>
  <main class="max-w-md md:max-w-6xl mx-auto px-4 md:px-6 py-6 md:py-8">
    <div x-show="activeTab === 'products'">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Products</p><p class="mt-1 text-2xl font-semibold" x-text="store.products.length"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Stock value</p><p class="mt-1 text-2xl font-semibold" x-text="'R' + inventoryValue().toLocaleString()"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Low stock</p><p class="mt-1 text-2xl font-semibold" :class="lowStockCount() > 0 ? 'text-orange-600' : 'text-gray-900'" x-text="lowStockCount()"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Sold out</p><p class="mt-1 text-2xl font-semibold" :class="outOfStockCount() > 0 ? 'text-red-600' : 'text-gray-900'" x-text="outOfStockCount()"></p></div>
      </div>
      <div class="mb-4 md:mb-6 space-y-3">
        <div class="flex gap-2">
          <div class="flex-1 relative"><input type="search" x-model="search" placeholder="Search products..." class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 bg-white focus:border-gray-900 focus:outline-none text-sm"><svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></div>
          <select x-model="sortBy" class="px-3 rounded-xl border border-gray-200 bg-white focus:border-gray-900 focus:outline-none text-sm"><option value="name">Name</option><option value="price-asc">Price Low-High</option><option value="price-desc">Price High-Low</option><option value="stock-asc">Stock Low-High</option><option value="stock-desc">Stock High-Low</option></select>
        </div>
        <div class="flex flex-wrap gap-2">
          <button @click="filterBy = 'all'" :class="filterBy === 'all' ? 'bg-gray-900 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">All <span x-text="'(' + store.products.length + ')'"></span></button>
          <button @click="filterBy = 'low'" :class="filterBy === 'low' ? 'bg-orange-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">Low stock <span x-text="'(' + lowStockCount() + ')'"></span></button>
          <button @click="filterBy = 'out'" :class="filterBy === 'out' ? 'bg-red-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">Sold out <span x-text="'(' + outOfStockCount() + ')'"></span></button>
        </div>
      </div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Products <span class="text-gray-400" x-text="'(' + store.products.length + ')'"></span></h2>
        <button @click="openNew()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-900 text-white text-sm font-medium"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Add Product</button>
      </div>
      <div class="md:bg-white md:rounded-2xl md:border md:border-gray-200 md:overflow-hidden">
        <div class="hidden md:grid grid-cols-[80px_1fr_140px_140px_100px] gap-4 px-5 py-3 bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wide"><div>Photo</div><div>Product</div><div>Price</div><div>Stock</div><div class="text-right">Actions</div></div>
        <div class="space-y-3 md:space-y-0 md:divide-y md:divide-gray-100">
          <template x-for="product in filteredProducts()" :key="product.id">
            <div class="md:grid md:grid-cols-[80px_1fr_140px_140px_100px] md:gap-4 md:px-5 md:py-4 md:hover:bg-gray-50 md:items-center">
              <div class="md:hidden flex gap-3 p-3 rounded-2xl bg-white border border-gray-100 items-center">
                <div class="w-16 h-16 rounded-xl bg-gray-100 flex-shrink-0 overflow-hidden"><img :src="product.image" class="w-full h-full object-cover" onerror="this.style.display='none'"></div>
                <div class="flex-1 min-w-0"><h3 class="font-medium text-gray-900 text-sm truncate" x-text="product.name"></h3><p class="text-xs text-gray-500 mt-0.5"><span x-text="'R' + product.price"></span> · <span x-text="product.stock == null ? 'Unlimited' : ('Stock ' + product.stock)"></span></p></div>
                <button @click="openEdit(store.products.indexOf(product))" class="px-4 py-2 rounded-xl bg-white border border-gray-200 text-sm font-medium">Edit</button>
              </div>
              <div class="hidden md:contents">
                <div class="w-16 h-16 rounded-xl bg-gray-100 overflow-hidden"><img :src="product.image" class="w-full h-full object-cover" onerror="this.style.display='none'"></div>
                <div class="min-w-0 self-center"><div class="font-medium text-gray-900 truncate" x-text="product.name"></div><div class="text-xs text-gray-500 truncate mt-0.5" x-text="product.blurb || ''"></div></div>
                <div class="text-sm font-medium self-center" x-text="'R' + product.price"></div>
                <div class="text-sm text-gray-600 self-center" x-text="product.stock == null ? 'Unlimited' : product.stock"></div>
                <div class="text-right self-center"><button @click="openEdit(store.products.indexOf(product))" class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100">Edit</button></div>
              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
    <div x-show="activeTab === 'orders'" x-cloak>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">New</p><p class="mt-1 text-2xl font-semibold" :class="ordersByStatus('new').length > 0 ? 'text-blue-600' : 'text-gray-900'" x-text="ordersByStatus('new').length"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">To ship</p><p class="mt-1 text-2xl font-semibold" :class="ordersByStatus('paid').length > 0 ? 'text-amber-600' : 'text-gray-900'" x-text="ordersByStatus('paid').length"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Shipped</p><p class="mt-1 text-2xl font-semibold" x-text="ordersByStatus('shipped').length"></p></div>
        <div class="p-4 rounded-2xl bg-white border border-gray-100"><p class="text-xs text-gray-500 font-medium uppercase tracking-wide">Delivered</p><p class="mt-1 text-2xl font-semibold text-gray-900" x-text="ordersByStatus('delivered').length"></p></div>
      </div>
      <div class="flex flex-wrap gap-2 mb-4">
        <button @click="orderFilter = 'all'" :class="orderFilter === 'all' ? 'bg-gray-900 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">All <span x-text="'(' + orders.length + ')'"></span></button>
        <button @click="orderFilter = 'new'" :class="orderFilter === 'new' ? 'bg-blue-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">New <span x-text="'(' + ordersByStatus('new').length + ')'"></span></button>
        <button @click="orderFilter = 'paid'" :class="orderFilter === 'paid' ? 'bg-amber-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">To ship <span x-text="'(' + ordersByStatus('paid').length + ')'"></span></button>
        <button @click="orderFilter = 'shipped'" :class="orderFilter === 'shipped' ? 'bg-emerald-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">Shipped <span x-text="'(' + ordersByStatus('shipped').length + ')'"></span></button>
        <button @click="orderFilter = 'delivered'" :class="orderFilter === 'delivered' ? 'bg-gray-600 text-white' : 'bg-white border border-gray-200 text-gray-700'" class="px-3 py-1.5 rounded-full text-xs font-medium">Delivered <span x-text="'(' + ordersByStatus('delivered').length + ')'"></span></button>
      </div>
      <div class="space-y-3">
        <template x-for="order in filteredOrders()" :key="order.ref">
          <button @click="openOrder(order)" class="w-full text-left p-4 rounded-2xl bg-white border border-gray-100 hover:border-gray-300 transition">
            <div class="flex items-start justify-between gap-3 mb-2">
              <div class="min-w-0"><div class="flex items-center gap-2 flex-wrap"><span class="mono text-xs text-gray-500" x-text="order.ref"></span><span :class="statusClass(order.status)" class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider" x-text="statusLabel(order.status)"></span></div>
              <h3 class="font-medium text-gray-900 mt-1" x-text="order.buyer.name"></h3></div>
              <div class="text-right whitespace-nowrap"><p class="font-semibold text-gray-900">R<span x-text="order.total"></span></p></div>
            </div>
            <p class="text-sm text-gray-600 line-clamp-1" x-text="orderSummary(order)"></p>
            <p class="text-xs text-gray-400 mt-1" x-text="timeAgo(order.createdAt)"></p>
          </button>
        </template>
        <p x-show="filteredOrders().length === 0" class="py-20 text-center text-sm text-gray-400">No orders yet.</p>
      </div>
    </div>
  </main>
  <div x-show="settingsOpen" class="fixed inset-0 z-50" x-cloak><div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @click="settingsOpen = false"></div><div class="absolute inset-x-0 bottom-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-3xl md:shadow-2xl md:max-w-3xl md:w-[90%] md:max-h-[90vh] bg-white rounded-t-3xl shadow-2xl max-h-[92vh] overflow-hidden flex flex-col"><header class="flex items-center justify-between px-5 py-4 border-b border-gray-100"><h2 class="text-base font-semibold">Store Settings</h2><button @click="settingsOpen = false" class="p-2 -mr-2 text-gray-500 hover:bg-gray-100 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button></header><div class="flex-1 overflow-y-auto p-5 md:p-6 md:grid md:grid-cols-2 md:gap-8"><div class="space-y-4"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Store info</p><div><label class="block text-sm font-medium text-gray-700 mb-2">Store name</label><input type="text" x-model="settings.brand.name" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Slogan</label><input type="text" x-model="settings.brand.tagline" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">WhatsApp order number</label><input type="text" x-model="settings.whatsapp" placeholder="+27821234567" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div></div><div class="space-y-4 mt-6 md:mt-0"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Bank details</p><div><label class="block text-sm font-medium text-gray-700 mb-2">Account holder</label><input type="text" x-model="settings.bank.accountName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Bank</label><input type="text" x-model="settings.bank.bankName" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Account number</label><input type="text" x-model="settings.bank.accountNumber" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Branch code</label><input type="text" x-model="settings.bank.branchCode" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div></div></div><div class="border-t border-gray-100 px-5 py-4 flex justify-end"><button @click="saveSettings()" class="w-full md:w-auto md:px-8 py-3 rounded-2xl bg-gray-900 text-white font-semibold">Save Settings</button></div></div></div>
  <div x-show="editOpen" class="fixed inset-0 z-50" x-cloak><div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @click="closeEdit()"></div><div class="absolute inset-x-0 bottom-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-3xl md:shadow-2xl md:max-w-5xl md:w-[90%] md:max-h-[92vh] bg-white rounded-t-3xl shadow-2xl max-h-[92vh] overflow-hidden flex flex-col"><header class="flex items-center justify-between px-5 py-4 border-b border-gray-100 flex-shrink-0"><button @click="closeEdit()" class="p-2 -ml-2 text-gray-600 hover:bg-gray-100 rounded-lg"><svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></button><h2 class="text-base font-semibold" x-text="editIndex === null ? 'New Product' : 'Edit Product'"></h2><button @click="deleteProduct()" x-show="editIndex !== null" class="p-2 -mr-2 text-red-600 hover:bg-red-50 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button></header><div class="flex-1 overflow-y-auto md:grid md:grid-cols-[320px_1fr] md:gap-8 md:p-8"><div class="p-5 md:p-0"><label class="block text-sm font-medium text-gray-700 mb-2">Product photo</label><div class="relative rounded-2xl overflow-hidden bg-gray-100 aspect-square"><img :src="editing.image" class="w-full h-full object-cover" x-show="editing.image" onerror="this.style.display='none'"><div x-show="!editing.image" class="absolute inset-0 flex items-center justify-center text-gray-300"><svg class="w-16 h-16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div><button @click="uploadPhoto()" class="absolute bottom-3 right-3 px-4 py-2 rounded-xl bg-white shadow-lg text-sm font-medium">Change photo</button></div></div><div class="p-5 md:p-0 space-y-4"><div><label class="block text-sm font-medium text-gray-700 mb-2">Product name</label><input type="text" x-model="editing.name" placeholder="e.g. iPhone 13" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Category</label><input type="text" x-model="editing.category" list="common-categories" placeholder="e.g. iPhones, Fragrances" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div class="grid grid-cols-2 gap-3"><div><label class="block text-sm font-medium text-gray-700 mb-2">Price (R)</label><input type="number" x-model.number="editing.price" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Stock</label><input type="number" x-model.number="editing.stock" placeholder="Blank = unlimited" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div></div><div><label class="block text-sm font-medium text-gray-700 mb-2">Short description</label><textarea x-model="editing.blurb" rows="2" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none resize-none"></textarea></div></div></div><div class="border-t border-gray-100 px-5 py-4 flex justify-end flex-shrink-0"><button @click="saveProduct()" :disabled="!editing.name || !editing.price" class="w-full md:w-auto md:px-8 py-3 rounded-2xl bg-gray-900 text-white font-semibold disabled:bg-gray-300">Save Product</button></div></div></div>
  <div x-show="orderOpen" class="fixed inset-0 z-50" x-cloak><div class="absolute inset-0 bg-black/40 backdrop-blur-sm" @click="orderOpen = false"></div><div class="absolute inset-x-0 bottom-0 md:inset-auto md:top-1/2 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-3xl md:shadow-2xl md:max-w-lg md:w-[90%] md:max-h-[90vh] bg-white rounded-t-3xl shadow-2xl max-h-[92vh] overflow-hidden flex flex-col"><header class="flex items-center justify-between px-5 py-4 border-b border-gray-100 flex-shrink-0"><div class="min-w-0"><p class="mono text-[10px] text-gray-500" x-text="activeOrder?.ref"></p><h2 class="text-base font-semibold truncate" x-text="activeOrder?.buyer.name"></h2></div><button @click="orderOpen = false" class="p-2 -mr-2 text-gray-500 hover:bg-gray-100 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button></header><div class="flex-1 overflow-y-auto p-5 space-y-5"><div class="flex items-center gap-3"><span :class="statusClass(activeOrder?.status)" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider" x-text="statusLabel(activeOrder?.status)"></span><span class="text-xs text-gray-500" x-text="activeOrder ? timeAgo(activeOrder.createdAt) : ''"></span></div><div class="space-y-2"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Items</p><template x-for="item in (activeOrder?.items || [])" :key="item.id + (item.variantName || '')"><div class="flex justify-between items-baseline text-sm"><span><span x-text="item.qty + '× ' + item.name"></span><span x-show="item.variantName" class="text-gray-500 text-xs ml-1" x-text="'(' + item.variantName + ')'"></span></span><span class="font-medium">R<span x-text="item.qty * item.price"></span></span></div></template><div class="flex justify-between items-baseline text-sm pt-2 border-t border-gray-100"><span class="text-gray-500">Shipping</span><span>R<span x-text="activeOrder?.shipping?.price || 0"></span></span></div><div class="flex justify-between items-baseline pt-2 border-t border-gray-100"><span class="font-semibold">Total</span><span class="font-semibold text-lg">R<span x-text="activeOrder?.total"></span></span></div></div><div class="space-y-2"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Delivery</p><p class="text-sm" x-text="activeOrder?.buyer.phone"></p><p class="text-sm text-gray-600" x-text="activeOrder?.buyer.address"></p><p x-show="activeOrder?.note" class="text-sm text-gray-500 italic mt-1" x-text="'Note: ' + activeOrder?.note"></p></div><div x-show="activeOrder?.status === 'shipped' || activeOrder?.status === 'delivered'" class="space-y-2"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Tracking</p><p class="text-sm"><span class="text-gray-500" x-text="activeOrder?.carrier"></span> · <span class="font-mono font-medium" x-text="activeOrder?.tracking"></span></p></div><div x-show="activeOrder?.status === 'paid'" class="space-y-3 pt-2 border-t border-gray-100"><p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Shipping details</p><select x-model="carrierInput" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"><option value="Paxi">Paxi (PEP to PEP)</option><option value="Courier">Courier door-to-door</option><option value="Own delivery">Delivering myself</option><option value="Collection">Collection by buyer</option></select><input type="text" x-model="trackingInput" placeholder="Tracking number (leave blank if none)" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-900 focus:outline-none"></div></div><div class="border-t border-gray-100 p-5 space-y-2 flex-shrink-0"><button x-show="activeOrder?.status === 'new'" @click="markPaid()" class="w-full py-4 rounded-2xl bg-emerald-600 text-white font-semibold">Confirm payment received</button><button x-show="activeOrder?.status === 'paid'" @click="markShipped()" class="w-full py-4 rounded-2xl bg-amber-600 text-white font-semibold">Mark as shipped & notify buyer</button><button x-show="activeOrder?.status === 'shipped'" @click="markDelivered()" class="w-full py-4 rounded-2xl bg-gray-900 text-white font-semibold">Mark as delivered</button><a :href="activeOrder ? trackLink(activeOrder) : '" target="_blank" x-show="activeOrder?.status !== 'new'" class="block w-full text-center py-3 rounded-2xl border border-gray-200 text-sm font-medium">View tracking page →</a><a :href="activeOrder ? waMessage(activeOrder) : '" target="_blank" class="block w-full text-center py-3 rounded-2xl border border-gray-200 text-sm font-medium">Message buyer on WhatsApp</a></div></div></div>
<script>
function sellerApp() {
return {
  loading: true,
  session: null, loginEmail: '', loginCode: '', loginStep: 'email',
  activeTab: 'products',
  brandId: 'techhub',
  store: { brand: { name: '', tagline: '' }, bank: {}, products: [] },
  orders: [],
  settings: {},
  editOpen: false, editIndex: null, editing: {},
  settingsOpen: false,
  orderOpen: false, activeOrder: null, orderFilter: 'all',
  trackingInput: '', carrierInput: 'Paxi',
  search: '', sortBy: 'name', filterBy: 'all',
  async init() {
    var params = new URLSearchParams(location.search);
    this.brandId = params.get('brand') || 'techhub';
    var sess = localStorage.getItem('session.' + this.brandId);
    if (sess) this.session = sess;
    try { var r = await fetch('/data/config-' + this.brandId + '.json?_=' + Date.now()); this.store = await r.json(); } catch(e) { console.error(e); }
    try { this.orders = JSON.parse(localStorage.getItem('orders.' + this.brandId) || '[]'); } catch(e) { this.orders = []; }
    if (this.orders.length === 0) this.seedDemoOrders();
    this.loading = false;
  },
  sendCode() { if (!this.loginEmail) return; this.loginStep = 'code'; },
  verifyCode() { if (this.loginCode && this.loginCode.length >= 4) { this.session = this.loginEmail; localStorage.setItem('session.' + this.brandId, this.loginEmail); } },
  skipLogin() { this.session = 'demo@example.com'; localStorage.setItem('session.' + this.brandId, 'demo@example.com'); },
  logout() { this.session = null; localStorage.removeItem('session.' + this.brandId); this.loginStep = 'email'; this.loginCode = ''; },
  ordersByStatus(s) { return this.orders.filter(function(o){ return o.status === s; }); },
  newOrdersCount() { return this.ordersByStatus('new').length; },
  filteredOrders() {
    var self = this;
    var list = this.orderFilter === 'all' ? this.orders.slice() : this.orders.filter(function(o){ return o.status === self.orderFilter; });
    return list.sort(function(a,b){ return new Date(b.createdAt) - new Date(a.createdAt); });
  },
  statusClass(s) {
    var m = { 'new': 'bg-blue-100 text-blue-800', 'paid': 'bg-amber-100 text-amber-800', 'shipped': 'bg-emerald-100 text-emerald-800', 'delivered': 'bg-gray-100 text-gray-700', 'cancelled': 'bg-red-100 text-red-800' };
    return m[s] || 'bg-gray-100 text-gray-700';
  },
  statusLabel(s) {
    var m = { 'new': 'New', 'paid': 'To ship', 'shipped': 'Shipped', 'delivered': 'Delivered', 'cancelled': 'Cancelled' };
    return m[s] || s;
  },
  openOrder(o) { this.activeOrder = o; this.trackingInput = o.tracking || ''; this.carrierInput = o.carrier || 'Paxi'; this.orderOpen = true; },
  markPaid() { this.activeOrder.status = 'paid'; this.activeOrder.paidAt = new Date().toISOString(); this.saveOrders(); this.orderOpen = false; this.flash(); },
  markShipped() {
    this.activeOrder.status = 'shipped';
    this.activeOrder.shippedAt = new Date().toISOString();
    this.activeOrder.tracking = this.trackingInput || null;
    this.activeOrder.carrier = this.carrierInput;
    this.saveOrders();
    var url = this.waNotifyShipped(this.activeOrder);
    this.orderOpen = false;
    this.flash();
    setTimeout(function(){ window.open(url, '_blank'); }, 400);
  },
  markDelivered() { this.activeOrder.status = 'delivered'; this.activeOrder.deliveredAt = new Date().toISOString(); this.saveOrders(); this.orderOpen = false; this.flash(); },
  saveOrders() { try { localStorage.setItem('orders.' + this.brandId, JSON.stringify(this.orders)); } catch(e) {} },
  trackLink(o) { return location.origin + '/track/?brand=' + this.brandId + '&ref=' + o.ref; },
  waMessage(o) {
    var d = String(this.store.whatsapp || '').replace(/\D/g, '' );
    var m = 'Hi ' + o.buyer.name + '! Re your order ' + o.ref + ':';
    return 'https://wa.me/' + d + '?text=' + encodeURIComponent(m);
  },
  waNotifyShipped(o) {
    var d = String(this.store.whatsapp || '').replace(/\D/g, '' );
    var lines = ['Hi ' + o.buyer.name + '! ', '', 'Your order ' + o.ref + ' has shipped. 🚚', '', 'Track it live:' + ' ', this.trackLink(o), ''];
    if (o.tracking) { lines.push('Tracking number: ' + o.tracking); }
    lines.push('');
    lines.push('Thanks for supporting ' + (this.store.brand?.name || 'my store') + '!');
    return 'https://wa.me/' + d + '?text=' + encodeURIComponent(lines.join('\n'));
  },
  timeAgo(iso) {
    if (!iso) return '';
    var s = (Date.now() - new Date(iso).getTime()) / 1000;
    if (s < 60) return 'just now';
    if (s < 3600) return Math.floor(s/60) + 'm ago';
    if (s < 86400) return Math.floor(s/3600) + 'h ago';
    if (s < 604800) return Math.floor(s/86400) + 'd ago';
    return new Date(iso).toLocaleDateString('en-ZA');
  },
  orderSummary(o) {
    var items = o.items || [];
    return items.map(function(i){ return i.qty + '× ' + i.name; }).join(', ');
  },
  seedDemoOrders() {
    var names = ['Nomsa K.', 'Sipho M.', 'Zanele D.', 'Thabo N.', 'Amara N.', 'Lerato T.'];
    var statuses = ['new', 'new', 'paid', 'paid', 'shipped', 'delivered'];
    var products = this.store.products || [];
    if (products.length === 0) return;
    var arr = [];
    for (var i = 0; i < 6; i++) {
      var p = products[i % products.length];
      var st = statuses[i];
      var d = new Date(); d.setDate(d.getDate() - (6 - i)); d.setHours(9 + i);
      var varName = (p.variants && p.variants[0]) ? p.variants[0].name : null;
      var ref = 'TE-' + String(d.getFullYear()).slice(2) + String(d.getMonth()+1).padStart(2,'0') + String(d.getDate()).padStart(2,'0') + '-' + String.fromCharCode(65 + i) + ((i*2)+1) + 'K' + (10 + i);
      arr.push({
        ref: ref, createdAt: d.toISOString(),
        buyer: { name: names[i], phone: '+2782000000' + i, address: 'Unit ' + (i+1) + ', 123 Main Rd, Sandton 2196' },
        items: [{ id: p.id, name: p.name, variantName: varName, price: p.price, qty: 1 }],
        subtotal: p.price, shipping: { name: 'Paxi (PEP to PEP)', price: 60 }, total: p.price + 60,
        status: st,
        paidAt: st !== 'new' ? d.toISOString() : null,
        shippedAt: (st === 'shipped' || st === 'delivered') ? d.toISOString() : null,
        deliveredAt: st === 'delivered' ? d.toISOString() : null,
        tracking: (st === 'shipped' || st === 'delivered') ? 'PEP' + (100000 + i * 1111) : null,
        carrier: (st === 'shipped' || st === 'delivered') ? 'Paxi' : null,
        note: ''
      });
    }
    this.orders = arr;
    this.saveOrders();
  },
  flash() { this.saved = true; var self = this; setTimeout(function(){ self.saved = false; }, 1800); },
  saved: false,
  inventoryValue() { return this.store.products.reduce(function(sum, p){ if (p.stock == null) return sum; return sum + p.price * p.stock; }, 0); },
  unlimitedCount() { return this.store.products.filter(function(p){ return p.stock == null; }).length; },
  lowStockCount() { return this.store.products.filter(function(p){ return p.stock != null && p.stock > 0 && p.stock <= 3; }).length; },
  outOfStockCount() { return this.store.products.filter(function(p){ return p.stock === 0; }).length; },
  filteredProducts() {
    var self = this;
    var q = (this.search || '').toLowerCase().trim();
    var list = (this.store.products || []).filter(function(p){
      if (self.filterBy === 'low' && !(p.stock > 0 && p.stock <= 3)) return false;
      if (self.filterBy === 'out' && p.stock !== 0) return false;
      if (q) { var h = ((p.name||'')+' '+(p.blurb||'')+' '+(p.category||'')).toLowerCase(); if (h.indexOf(q) === -1) return false; }
      return true;
    });
    var s = this.sortBy;
    list.sort(function(a,b){
      if (s === 'price-asc') return a.price - b.price;
      if (s === 'price-desc') return b.price - a.price;
      if (s === 'stock-asc') return (a.stock||0) - (b.stock||0);
      if (s === 'stock-desc') return (b.stock||0) - (a.stock||0);
      return (a.name||'').localeCompare(b.name||'');
    });
    return list;
  },
  openEdit(i) { this.editIndex = i; var p = JSON.parse(JSON.stringify(this.store.products[i])); if (!p.specs) p.specs = []; if (!p.options) p.options = []; this.editing = p; this.editOpen = true; },
  openNew() { this.editIndex = null; this.editing = { id: 'item-' + Date.now(), name: '', price: 0, stock: null, blurb: '', image: '', category: '', specs: [], options: [] }; this.editOpen = true; },
  closeEdit() { this.editOpen = false; this.editing = {}; this.editIndex = null; },
  addSpec() { if (!this.editing.specs) this.editing.specs = []; this.editing.specs.push(''); },
  saveProduct() {
    if (!this.editing.name || !this.editing.price) return;
    var c = JSON.parse(JSON.stringify(this.editing));
    c.specs = (c.specs || []).filter(function(s){ return s && s.trim(); });
    if (c.specs.length === 0) delete c.specs;
    delete c.options;
    if (this.editIndex === null) this.store.products.push(c);
    else this.store.products[this.editIndex] = c;
    this.commit('Product saved');
    this.closeEdit();
  },
  deleteProduct() { if (!confirm('Delete this product?')) return; this.store.products.splice(this.editIndex, 1); this.commit('Product deleted'); this.closeEdit(); },
  openSettings() { this.settings = JSON.parse(JSON.stringify(this.store)); this.settingsOpen = true; },
  saveSettings() { this.store.brand = this.settings.brand; this.store.bank = this.settings.bank; this.store.whatsapp = this.settings.whatsapp; this.commit('Settings saved'); this.settingsOpen = false; },
  async commit(msg) {
    this.flash();
    var payload = { brand: this.brandId, data: this.store, message: msg };
    try { await fetch('/api/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }); }
    catch(e) { console.log('[seller] local save', msg); }
  },
  uploadPhoto() {
    var self = this;
    var input = document.createElement('input');
    input.type = 'file'; input.accept = 'image/*';
    input.onchange = async function() {
      var f = input.files[0]; if (!f) return;
      var form = new FormData(); form.append('file', f); form.append('upload_preset', 'outreach_unsigned'); form.append('folder', 'products');
      try {
        var r = await fetch('https://api.cloudinary.com/v1_1/e4kmlh67/image/upload', { method: 'POST', body: form });
        var d = await r.json();
        if (d.secure_url) self.editing.image = d.secure_url + '?q_auto,f_auto,w_1000';
        else alert('Upload failed');
      } catch(e) { alert('Upload failed'); }
    };
    input.click();
  },
};
}
</script>
</body>
</html>
